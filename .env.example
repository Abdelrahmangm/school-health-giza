# Only a TEST Supabase project. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set in local .env.local only, after security review of your TEST instance.
# Server authentication uses cookies and the public key; no service-role key needed.
# Server-only (Vercel → Settings → Environment Variables, NOT prefixed NEXT_PUBLIC_):
# secret key used ONLY to send invitation / password e-mails through Supabase Auth.
SUPABASE_SECRET_KEY=
# Public address of the app used in e-mail links, e.g. https://school-health-giza.vercel.app
SITE_URL=
