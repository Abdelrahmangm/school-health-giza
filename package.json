{
  "name": "school-health-giza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "playwright test",
    "test:integration": "bash scripts/test-integration.sh",
    "test:integration:local": "bash scripts/test-integration-local.sh",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.76.0",
    "fflate": "^0.8.3",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
